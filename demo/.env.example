# Copy to `.env` (Bun loads it automatically) and tweak as needed.

# Port the demo server listens on. The mod's default apiBaseUrl points at 8080.
PORT=8080

# Origin used to build the browser link returned to the mod. Change this if you
# run the server behind a tunnel/proxy (e.g. https://shop.example.com).
PUBLIC_URL=http://localhost:8080

# Shared secret. If set, the mod must send a matching X-Webshop-Api-Key header
# (configure the same value as `apiKey` in webshoplink-common.toml).
# Leave empty to disable the check entirely.
WEBSHOP_API_KEY=
